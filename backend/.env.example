# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://reachinbox_user:reachinbox_password@localhost:5432/reachinbox_db?schema=public"

# Redis (via Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ & Scheduler Settings
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# Authentication
JWT_SECRET=reachinbox_super_secure_jwt_secret_key_2026
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# SMTP / Ethereal Email (Leave blank to automatically create an Ethereal test account on startup)
ETHEREAL_USER=
ETHEREAL_PASS=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
